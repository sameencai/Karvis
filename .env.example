# ============ Karvis 环境变量配置 ============
# 复制此文件为 .env，填入真实值后使用。
# 腾讯云 SCF 部署时通过「环境变量」面板配置即可。

# --- DeepSeek API（Main/Think 模型） ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v3.2

# --- Qwen Flash API（阿里云百炼，用于轻量任务如主动陪伴） ---
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus-latest

# --- OneDrive（用于读写 Obsidian Vault） ---
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret
ONEDRIVE_REFRESH_TOKEN=your-onedrive-refresh-token

# --- 企业微信（WeWork）应用 ---
WEWORK_CORP_ID=your-corp-id
WEWORK_AGENT_ID=1000003
WEWORK_CORP_SECRET=your-corp-secret
WEWORK_TOKEN=your-callback-token
WEWORK_ENCODING_AES_KEY=your-encoding-aes-key

# --- 腾讯云 ASR（语音识别，可选） ---
TENCENT_APPID=your-tencent-appid
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# --- Obsidian Vault 路径（OneDrive 上的相对路径） ---
OBSIDIAN_BASE=/应用/remotely-save/EmptyVault

# --- 心知天气（可选） ---
SENIVERSE_KEY=your-seniverse-api-key
WEATHER_CITY=北京

# --- 默认企微用户 ID（定时任务推送目标） ---
DEFAULT_USER_ID=YourWeWorkUserID

# --- 异步处理端点（SCF 部署后的公网 URL） ---
# 企微 5 秒超时 → 消息异步转发到此 URL 处理
PROCESS_ENDPOINT_URL=https://your-scf-url.tencentscf.com/process

# --- 主动陪伴参数（可选，有默认值） ---
# COMPANION_SILENT_HOURS=4       # 沉默超过 N 小时触发信号
# COMPANION_INTERVAL_HOURS=4     # 两次推送最小间隔
# COMPANION_MAX_DAILY=3          # 每天最多推送次数
# COMPANION_RECENT_HOURS=2       # 近期有互动则跳过
